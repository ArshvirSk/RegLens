# RegLens environment template. Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env

# ---------- runtime ----------
REGLENS_ENV=local
REGLENS_LOG_LEVEL=INFO
REGLENS_SEED=1337                      # global random seed for reproducibility
REGLENS_CORPUS_VERSION=0.1.0           # bump when the indexed corpus changes
REGLENS_EXPERIMENT_CONFIG=baseline_naive

# ---------- postgres (docker compose maps host port 5433 -> container 5432) ----------
POSTGRES_USER=reglens
POSTGRES_PASSWORD=reglens_local_dev    # local-only default; change for anything shared
POSTGRES_DB=reglens
POSTGRES_HOST=localhost
POSTGRES_PORT=5433                     # host-side port; inside compose it is postgres:5432
REGLENS_DATABASE_URL=postgresql://reglens:reglens_local_dev@localhost:5433/reglens
# Read-only role used by the numeric/text-to-SQL tool from Phase 3 onwards.
REGLENS_READONLY_DATABASE_URL=postgresql://reglens_ro:reglens_ro_local_dev@localhost:5433/reglens

# ---------- api ----------
REGLENS_API_HOST=0.0.0.0
REGLENS_API_PORT=8000
REGLENS_CORS_ORIGINS=http://localhost:3000

# ---------- storage ----------
# Raw files are immutable and content-addressed by SHA-256.
REGLENS_DATA_DIR=./data
REGLENS_RAW_DIR=./data/raw
REGLENS_PARSED_DIR=./data/parsed

# ---------- embeddings (Phase 1+) ----------
# Provider abstraction lives in src/reglens/indexing/embeddings.py. Phase 1 ships the
# hosted option; Phase 2 adds the open-source option for the ablation.
REGLENS_EMBEDDING_PROVIDER=openai
REGLENS_EMBEDDING_MODEL=text-embedding-3-small
REGLENS_EMBEDDING_DIM=1536
OPENAI_API_KEY=

# ---------- generation (Phase 1+) ----------
REGLENS_LLM_PROVIDER=openai
REGLENS_LLM_MODEL_SMALL=gpt-4o-mini
REGLENS_LLM_MODEL_LARGE=gpt-4o
REGLENS_LLM_TEMPERATURE=0.0
ANTHROPIC_API_KEY=

# ---------- reranker (Phase 2) ----------
REGLENS_RERANKER_ENABLED=false
REGLENS_RERANKER_MODEL=BAAI/bge-reranker-base

# ---------- tracing / observability ----------
# Traces are always written to Postgres; exporters below are opt-in.
REGLENS_TRACING_ENABLED=true
REGLENS_TRACE_DB_WRITE=true
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---------- fetcher politeness ----------
# Identifies the crawler to source sites and keeps request rates low.
REGLENS_USER_AGENT=RegLens/0.1 (research; contact: you@example.com)
REGLENS_FETCH_DELAY_SECONDS=2.0
REGLENS_FETCH_TIMEOUT_SECONDS=60
REGLENS_FETCH_MAX_BYTES=52428800

# ---------- web ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
